{
  "name": "liturgia-stream",
  "version": "0.1.0",
  "private": false,
  "description": "Liturgia Worship streaming companion",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check sourceStyleEditor.js && node --check settingsStore.js && node --check ffmpegRuntime.js && node --check outputManager.js",
    "build": "electron-builder",
    "test": "jest --runInBand",
    "build:win": "electron-builder --win --x64 --publish=never",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac || true && electron-builder --linux || true && electron-builder --win || true"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^26.4.0",
    "jest": "^29.6.1"
  },
  "build": {
    "appId": "com.jacqueb.liturgia.stream",
    "productName": "Liturgia Stream",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Liturgia Stream",
      "runAfterFinish": false
    },
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/test",
      "!**/*.map"
    ],
    "icon": "build/icon",
    "artifactName": "liturgia-stream.${ext}",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  },
  "author": "Jacqueb <contact@jacqueb.me>"
}
